<UserControl x:Class="AudioPriorityTray.DeviceSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AudioPriorityTray.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SectionViewModel}">
  <StackPanel Margin="0,0,0,8">
    <StackPanel Orientation="Horizontal" Margin="8,6,0,6">
      <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <TextBlock Text="No devices" Margin="12,6,0,6" FontSize="12" FontStyle="Italic"
               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

    <Grid>
      <ItemsControl x:Name="Items" ItemsSource="{Binding Rows}" Focusable="False"
                    PreviewMouseLeftButtonDown="OnPreviewMouseDown"
                    PreviewMouseMove="OnPreviewMouseMove"
                    PreviewMouseLeftButtonUp="OnPreviewMouseUp"
                    LostMouseCapture="OnLostMouseCapture">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DeviceRowViewModel}">
            <Border x:Name="Row" Height="40" Margin="0,1" CornerRadius="4" BorderThickness="1"
                    Background="Transparent" BorderBrush="Transparent" MouseRightButtonUp="OnRowRightClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <!-- Windows 11 list selection indicator -->
                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="Priority" Text="{Binding PriorityText}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="Grip" Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock x:Name="DeviceName" Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                  <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                             Margin="6,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <Border x:Name="MutedBadge" Visibility="Collapsed" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                          VerticalAlignment="Center" Background="{DynamicResource SystemFillColorCriticalBrush}">
                    <TextBlock Text="Muted" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                  </Border>
                </StackPanel>

                <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28"
                        FontSize="14" Content="&#xE712;" Visibility="Hidden" Click="OnMoreClick"
                        ToolTip="Device options" AutomationProperties.Name="Device options" />
              </Grid>
            </Border>

            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsNeverUse}" Value="True">
                <Setter TargetName="DeviceName" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="DeviceName" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.6" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMuted}" Value="True">
                <Setter TargetName="MutedBadge" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Priority" Property="Visibility" Value="Hidden" />
                <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                <Setter TargetName="MoreButton" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsActive}" Value="True" />
                  <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </MultiDataTrigger>
              <DataTrigger Binding="{Binding IsDragging}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Canvas IsHitTestVisible="False">
        <Border x:Name="DropIndicator" Height="2" CornerRadius="1" Visibility="Collapsed"
                Background="{DynamicResource AccentFillColorDefaultBrush}" />
      </Canvas>
    </Grid>
  </StackPanel>
</UserControl>
