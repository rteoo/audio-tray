<Window x:Class="AudioPriorityTray.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioPriorityTray"
        xmlns:vm="clr-namespace:AudioPriorityTray.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AudioTray"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True">
  <!-- Client area covers the whole DWM frame so the system backdrop, border and shadow show. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="EntranceOffset" />
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Raw DWM Acrylic samples whatever is behind it and reads mid-grey over bright windows.
         Windows' own flyouts layer a theme tint over it; this is that tint, using the canvas color. -->
    <Border Grid.RowSpan="3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.9" />

    <!-- Mode and volume -->
    <StackPanel Margin="16">
      <UniformGrid Columns="3" AutomationProperties.Name="Mode">
        <RadioButton Style="{StaticResource ModeTile}" GroupName="Mode" Margin="0,0,4,0" Content="Speakers" Tag="&#xE767;"
                     IsChecked="{Binding IsSpeakerMode, Mode=OneWay}" Click="OnSpeakerModeClick"
                     ToolTip="Auto-switch between speakers" />
        <RadioButton Style="{StaticResource ModeTile}" GroupName="Mode" Margin="4,0" Content="Headphones" Tag="&#xE7F6;"
                     IsChecked="{Binding IsHeadphoneMode, Mode=OneWay}" Click="OnHeadphoneModeClick"
                     ToolTip="Auto-switch between headphones" />
        <RadioButton Style="{StaticResource ModeTile}" GroupName="Mode" Margin="4,0,0,0" Content="Manual" Tag="&#xE815;"
                     IsChecked="{Binding IsCustomMode, Mode=OneWay}" Click="OnManualModeClick"
                     ToolTip="Manual: pick devices yourself, no auto-switching" />
      </UniformGrid>

      <Grid Margin="0,16,0,0" Background="Transparent" PreviewMouseWheel="OnVolumeWheel">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" />
        <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                IsMoveToPointEnabled="True" VerticalAlignment="Center"
                AutomationProperties.Name="Volume"
                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="12" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </Grid>
    </StackPanel>

    <!-- Device lists -->
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="8">
          <local:DeviceSectionView DataContext="{Binding Speakers}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
          <local:DeviceSectionView DataContext="{Binding Headphones}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
          <local:DeviceSectionView DataContext="{Binding Microphones}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Footer bar -->
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" Padding="8,4">
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Click="OnIgnoredClick"
                ToolTip="Show ignored devices" Visibility="{Binding ShowIgnored, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xED1A;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding IgnoredCount, StringFormat='{}{0} ignored'}" />
          </StackPanel>
        </Button>

        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;"
                ToolTip="More options" AutomationProperties.Name="More options" Click="OnMoreClick" />
        <Button DockPanel.Dock="Right" Click="OnEditClick" Margin="0,0,4,0"
                ToolTip="Show every device ever connected, including disconnected and ignored ones">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE70F;" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                      <Setter Property="Text" Value="&#xE8FB;" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Edit" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                      <Setter Property="Text" Value="Done" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>
  </Grid>
</Window>
