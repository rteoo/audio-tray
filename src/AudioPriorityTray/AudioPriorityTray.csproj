<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AudioPriorityTray.ico</ApplicationIcon>
    <Product>Audio Priority</Product>
    <Version>1.0.0</Version>
    <!-- WPF's Windows 11 (Fluent) theme, Application.ThemeMode, is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioPriorityTray.Core\AudioPriorityTray.Core.csproj" />
  </ItemGroup>
</Project>
